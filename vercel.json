{
  "version": 2,
  "public": true,
  "routes": [
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "/foodieexpress_frontend/assets/$1" },
    { "src": "/img/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "/foodieexpress_frontend/img/$1" },
    { "src": "/(.*)", "dest": "/foodieexpress_frontend/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}